  created_at datetime [default: CURRENT_TIMESTAMP]
  created_by int
  updated_at datetime [default: CURRENT_TIMESTAMP]
  updated_by int
}

Table user_logs {
  log_id bigint [pk, increment]
  actor_user_id int
  action varchar(100) [not null]
  module varchar(100) [not null, default: 'system']
  target_type varchar(100)
  target_id varchar(100)
  description text
  metadata text
  ip_address varchar(64)
  user_agent text
  created_at timestamp [not null, default: CURRENT_TIMESTAMP]
}

Table user_notifications {
  notification_id bigint unsigned [pk, increment]
  recipient_user_id int [not null]
  actor_user_id int
  title varchar(255) [not null]
  message text [not null]
  category varchar(80) [not null, default: 'general']
  reference_module varchar(80)
  reference_id varchar(120)
  status enum('unread','read') [not null, default: 'unread']
  created_at datetime [not null, default: CURRENT_TIMESTAMP]
  read_at datetime
}

Table user_role_assignments {
  assignment_id int [pk, increment]
  user_id int [not null]
  role_id int [not null]
  assigned_by int
  created_at timestamp [default: CURRENT_TIMESTAMP]

  indexes {
    (user_id, role_id) [unique, name: 'uq_user_role']
  }
}

Table user_roles {
  user_role_id int [pk, increment]
  user_id int [not null]
  created_at datetime [default: CURRENT_TIMESTAMP]
  updated_at datetime [default: CURRENT_TIMESTAMP]
  created_by int
  updated_by int
}

Table users {
  user_id int [pk, increment]
  username varchar(50) [not null, unique]
  password varchar(255) [not null]
  role enum('employee','admin','supervisor','superadmin') [default: 'employee']
  is_active tinyint(1) [default: 1]
  created_at datetime [default: CURRENT_TIMESTAMP]
  updated_at datetime [default: CURRENT_TIMESTAMP]
  created_by int
  updated_by int
}

Table vendors {
  vendor_id int [pk, increment]
  vendor_name varchar(255) [not null]
  contact_person varchar(255) [not null]
  email varchar(255) [not null]
  phone varchar(50) [not null]
  address text [not null]
  created_at timestamp [default: CURRENT_TIMESTAMP]
  updated_at timestamp [default: CURRENT_TIMESTAMP]
}

